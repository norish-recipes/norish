{
  "$schema": "https://json.schemastore.org/tsconfig",
  // TypeScript 6 already turns on strict and esModuleInterop, and with module Preserve it
  // resolves like a bundler and imports JSON. Its types list starts empty, so a workspace
  // that uses Node names "node" in its own tsconfig.
  "compilerOptions": {
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "allowJs": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "allowImportingTsExtensions": true,

    "incremental": true,
    "disableSourceOfProjectReferenceRedirect": true,
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.json",

    "noUncheckedIndexedAccess": true,

    "module": "Preserve",
    "noEmit": true
  },
  "exclude": ["node_modules", "build", "dist", ".next", ".expo"]
}
