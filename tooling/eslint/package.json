    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-turbo": "^2.11.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  },
  "devDependencies": {
    "@norish/prettier-config": "workspace:*",
    "@norish/tsconfig": "workspace:*",
