{
  "name": "@norish/eslint-config",
  "private": true,
  "type": "module",
  "exports": {
    "./base": "./base.ts",
    "./react": "./react.ts",
    "./nextjs": "./nextjs.ts",
    "./features": "./features.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "typecheck": "pnpm exec tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "^16.4.6",
    "@stylistic/eslint-plugin": "^6.0.1",
    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-turbo": "^2.11.13",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.73.0"
  },
  "devDependencies": {
    "@norish/prettier-config": "workspace:*",
    "@norish/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@norish/prettier-config"
}
