{
  "$schema": "https://turborepo.com/schema.json",
  "concurrency": "3",
  "globalDependencies": [".github/workflows/**", "pnpm-workspace.yaml"],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "npm_lifecycle_event",
    "SKIP_ENV_VALIDATION",
    "DATABASE_URL",
    "MASTER_KEY",
    "AUTH_URL",
    "OBSCURA_ENDPOINT",
    "OBSCURA_CDP_TOKEN",
    "VALKEY_URL",
    "PARSER_API_TIMEOUT_MS",
    "UPLOADS_DIR",
    "YT_DLP_BIN_DIR"
  ],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".cache/**", "**/*.tsbuildinfo"]
    },
    "dev": {
      "dependsOn": ["^dev"],
      "cache": false,
      "persistent": true
    },
    "lint:check": {
      "dependsOn": ["^lint:check"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["**/*.tsbuildinfo", ".cache/**"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "format": {
      "dependsOn": ["^format"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "deps:cycles": {
      "cache": false
    }
  }
}
