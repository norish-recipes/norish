+/// The x's cancel collapses the search tab's field; selecting the tab again brings it back. Out to `other`
+/// and back, unseen by JS and without animation.
+- (void)reselectSearchTabVia:(UITab *)other API_AVAILABLE(ios(18.0))
+{
+  UITab *searchTab = self.selectedTab;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    if (self.selectedTab != searchTab) {
+      return;
+    }
+    self->_isApplyingProgrammaticTabSelection = YES;
+    self->_isHandlingExplicitSelectionUpdate = YES;
+    [UIView performWithoutAnimation:^{
+      [super setSelectedTab:other];
+      [super setSelectedTab:searchTab];
+      [self.view layoutIfNeeded];
+    }];
+    self->_isHandlingExplicitSelectionUpdate = NO;
+    self->_isApplyingProgrammaticTabSelection = NO;
+  });
+}
