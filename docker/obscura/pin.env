# The Obscura build Norish ships.
#
# Obscura is the headless browser that renders pages for URL imports. Norish
# repackages the `-stealth` release archive into its own image rather than
# pulling upstream's, because upstream publishes only the render-only build —
# there, `--stealth` is a flag with no transport behind it. The archive comes
# from Norish's fork, upstream's release with Norish's patches (see README.md
# next to this file).
#
# This file records what the image contains: the fork release it
# repackages, and the tag Norish publishes it under. Bump both and move the
# Compose surfaces to the new tag. The push runs the **Publish Obscura image**
# workflow.
#
# Shell-sourceable on purpose: `set -a; . docker/obscura/pin.env; set +a`.

OBSCURA_REPO=https://github.com/norish-recipes/obscura
# Keep in step with the Dockerfile's ARG default, so a bare
# `docker build docker/obscura` builds what the workflow publishes.
OBSCURA_VERSION=0.2.4-norish.1

OBSCURA_IMAGE=docker.io/norishapp/obscura
# `<upstream version>-norish.<build>`: the build counter moves when the image
# changes without the upstream release moving (a patch, a Dockerfile or
# base-image fix).
OBSCURA_IMAGE_TAG=0.2.4-norish.2
