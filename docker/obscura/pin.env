# The Obscura build Norish ships.
#
# Obscura is the headless browser that renders pages for URL imports. Norish
# repackages upstream's `-stealth` release archive into its own image rather
# than pulling upstream's, because upstream publishes only the render-only
# build — there, `--stealth` is a flag with no transport behind it (see
# README.md next to this file).
#
# This file records what the image contains: the upstream release it
# repackages, and the tag Norish publishes it under. Bump both, run the
# **Publish Obscura image** workflow, then move the Compose surfaces to the new
# tag.
#
# Shell-sourceable on purpose: `set -a; . docker/obscura/pin.env; set +a`.

OBSCURA_REPO=https://github.com/h4ckf0r0day/obscura
# Keep in step with the Dockerfile's ARG default, so a bare
# `docker build docker/obscura` builds what the workflow publishes.
OBSCURA_VERSION=0.2.2

OBSCURA_IMAGE=docker.io/norishapp/obscura
# `<upstream version>-norish.<build>`: the build counter moves when the image
# changes without the upstream release moving (a Dockerfile or base-image fix).
OBSCURA_IMAGE_TAG=0.2.2-norish.1
