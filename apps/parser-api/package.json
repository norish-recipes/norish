{
  "name": "@norish/parser-api",
  "version": "0.18.0-beta",
  "private": true,
  "scripts": {
    "postinstall": "sh -c 'if [ \"${SKIP_PARSER_API_INSTALL:-0}\" = \"1\" ]; then exit 0; fi; uv sync --locked'",
    "install:deps": "uv sync --locked",
    "dev": "sh -c 'uv run --locked uvicorn app.main:app --app-dir . --reload --host ${PARSER_API_HOST:-0.0.0.0} --port ${PARSER_API_PORT:-8001}'"
  }
}
