{
  "extends": "@norish/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "dom", "dom.iterable"],
    "noImplicitAny": false,
    "noCheck": true, // This needs to be fixed, https://github.com/norish-recipes/norish/issues/333
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "~/*": ["./*"],
      "@norish/web/*": ["./*"],
      "@norish/auth/*": ["../../packages/auth/src/*"],
      "@norish/queue/*": ["../../packages/queue/src/*"]
    }
  },
  "include": [".", ".next/types/**/*.ts"],
  // app/sw.ts is a service-worker entry compiled by @serwist/next in a webworker
  // environment; it is excluded from the app's DOM-lib type program and checked
  // by its own program instead (tsconfig.sw.json, run via `typecheck`).
  "exclude": ["node_modules", "app/sw.ts"]
}
