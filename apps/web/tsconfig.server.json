{
  "extends": "@norish/tsconfig/base.json",
  "include": ["server/index.ts", "server/**/*"],
  "exclude": ["node_modules", ".next"],
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2022",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": false,
    "incremental": false
  }
}
