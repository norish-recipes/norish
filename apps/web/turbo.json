{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".next/**"]
    },
    "test": {
      "env": ["DATABASE_URL", "MASTER_KEY", "AUTH_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL", "MASTER_KEY", "AUTH_URL"]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "@norish/trpc#build"]
    }
  }
}
