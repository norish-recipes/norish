{
  "name": "@norish/web",
  "version": "0.26.0-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "pnpm run build:web",
    "build:web": "next build",
    "start": "node --import tsx server/index.ts",
    "test": "vitest --config ./vitest.config.ts",
    "test:run": "vitest run --config ./vitest.config.ts",
    "test:e2e": "playwright test -c __tests__/e2e/playwright.config.ts",
    "test:coverage": "vitest run --coverage --config ./vitest.config.ts",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "typecheck": "next typegen && pnpm exec tsc --noEmit && pnpm exec tsc -p tsconfig.sw.json",
    "clean": "git clean -xdf .cache .next .turbo node_modules dist",
    "generate:splash": "tsx scripts/generate-splash.tsx",
    "measure:page-loads": "tsx scripts/measure-page-loads.ts"
  },
