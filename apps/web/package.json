{
  "name": "@norish/web",
  "version": "0.20.0-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "pnpm run build:web && pnpm run build:server",
    "build:web": "next build --webpack",
    "build:server": "tsdown --config ./tsdown.config.ts",
    "start": "node ../../dist-server/index.mjs",
    "test": "vitest --config ./vitest.config.ts",
    "test:run": "vitest run --config ./vitest.config.ts",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:ai": "playwright test -c e2e-ai/playwright.config.ts",
    "screenshots:docs": "playwright test -c e2e-ai/screenshots.config.ts",
    "test:coverage": "vitest run --coverage --config ./vitest.config.ts",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "typecheck": "pnpm exec tsc --noEmit && pnpm exec tsc -p tsconfig.sw.json",
    "clean": "git clean -xdf .cache .next .turbo node_modules dist"
  },
  "dependencies": {
    "@better-auth/api-key": "catalog:",
    "@better-auth/core": "catalog:",
    "@better-auth/utils": "catalog:",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/fira-code": "^5.2.7",
    "@fontsource-variable/inter": "^5.2.8",
    "@heroicons/react": "catalog:",
    "@heroui/react": "^3.1.0",
    "@heroui/styles": "^3.1.0",
    "@iconify/react": "^6.0.2",
    "@internationalized/date": "^3.12.1",
    "@norish/api": "workspace:*",
    "@norish/auth": "workspace:*",
    "@norish/config": "workspace:*",
    "@norish/db": "workspace:*",
    "@norish/i18n": "workspace:*",
    "@norish/queue": "workspace:*",
    "@norish/shared": "workspace:*",
    "@norish/shared-react": "workspace:*",
    "@norish/shared-server": "workspace:*",
    "@norish/trpc": "workspace:*",
    "@norish/ui": "workspace:*",
    "@scalar/nextjs-api-reference": "catalog:",
    "@serwist/next": "^9.5.11",
    "@tanstack/query-persist-client-core": "^5.100.8",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-virtual": "^3.13.24",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "better-auth": "catalog:",
    "date-fns": "catalog:",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "motion": "12.38.0",
    "next": "catalog:",
    "next-intl": "^4.12.0",
    "next-themes": "0.4.6",
    "react": "catalog:",
    "react-aria-components": "1.17.0",
    "react-dom": "catalog:",
    "react-markdown": "^10.1.0",
    "server-only": "catalog:",
    "serwist": "^9.5.11",
