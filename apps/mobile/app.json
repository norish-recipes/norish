{
  "expo": {
    "name": "Norish",
    "slug": "norish",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "norish",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8F3E7",
    "ios": {
      "bundleIdentifier": "dev.norish.app",
      "supportsTablet": false
    },
    "android": {
      "package": "dev.norish.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8F3E7",
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "monochromeImage": "./assets/brand/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F3E7",
          "image": "./assets/brand/splash.png",
          "imageWidth": 175,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#14110D",
            "image": "./assets/brand/splash-dark.png"
          }
        }
      ],
      "expo-system-ui",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
