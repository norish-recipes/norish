{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@norish/trpc/*": ["../../packages/trpc/dist/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "plugins/**/*.js",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "declarations.d.ts"
  ]
}
