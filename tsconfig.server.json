{
  "include": ["apps/web/server/index.ts", "apps/web/server/**/*", "db/**/*"],
  "exclude": ["node_modules", ".next"],
  "compilerOptions": {
    "outDir": "dist-server",
    "module": "CommonJS",
    "target": "ES2022",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*", "./apps/web/*"],
      "@norish/shared": ["./packages/shared/src/index.ts"],
      "@norish/shared/*": ["./packages/shared/src/*"],
      "@norish/api": ["./packages/api/src/index.ts"],
      "@norish/api/*": ["./packages/api/src/*"],
      "@norish/auth": ["./packages/auth/src/index.ts"],
      "@norish/auth/*": ["./packages/auth/src/*"],
      "@norish/db": ["./packages/db/src/index.ts"],
      "@norish/db/*": ["./packages/db/src/*"],
      "@norish/queue": ["./packages/queue/src/index.ts"],
      "@norish/queue/*": ["./packages/queue/src/*"],
      "@norish/config": ["./packages/config/src/index.ts"],
      "@norish/config/*": ["./packages/config/src/*"],
      "@norish/i18n": ["./packages/i18n/src/index.ts"],
      "@norish/i18n/*": ["./packages/i18n/src/*"],
      "@norish/ui": ["./packages/ui/src/index.ts"],
      "@norish/ui/*": ["./packages/ui/src/*"],
      "@norish/web": ["./apps/web/src/index.ts"],
      "@norish/web/*": ["./apps/web/*"]
    }
  }
}
