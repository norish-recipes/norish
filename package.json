{
  "name": "norish",
  "version": "0.17.0-beta",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "pnpm --filter @norish/web run dev",
    "build:web": "pnpm --filter @norish/web run build:web",
    "build": "pnpm run build:web && pnpm run build:server && pnpm run update-sw",
    "build:server": "pnpm --filter @norish/web run build:server",
    "update-sw": "pnpm --filter @norish/web run update-sw",
    "clean:install": "pnpm install --frozen-lockfile",
    "build:prod": "pnpm run clean:install && cross-env NODE_ENV=production pnpm run build",
    "db:ensure": "node -e \"console.log('drizzle-kit handles database validation during push/generate')\"",
    "db:push": "drizzle-kit push --config ./packages/db/src/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config ./packages/db/src/drizzle.config.ts",
    "migrate": "drizzle-kit push --config ./packages/db/src/drizzle.config.ts",
    "docker:build": "docker build -f docker/Dockerfile -t norishapp/norish:test .",
    "docker:up": "docker compose -f docker-compose.local.yml up -d",
    "docker:down": "docker compose -f docker-compose.local.yml down",
    "docker:tag": "docker tag norishapp/norish:test norishapp/norish:${npm_package_version}",
    "docker:push": "docker push norishapp/norish:${npm_package_version}",
    "docker:push:test": "docker push norishapp/norish:test",
    "start": "pnpm --filter @norish/web run start",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx && pnpm run monorepo:check",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "deps:cycles": "node scripts/check-circular-deps.mjs",
    "deps:workspace": "node scripts/check-workspace-dependencies.mjs",
    "hygiene:root": "node scripts/check-root-hygiene.mjs",
    "monorepo:check": "pnpm run hygiene:root && pnpm run deps:workspace",
    "i18n:check": "node scripts/check-locale-keys.js"
  },
  "dependencies": {
    "@norish/api": "workspace:*",
    "@norish/auth": "workspace:*",
    "@norish/config": "workspace:*",
    "@norish/db": "workspace:*",
    "@norish/i18n": "workspace:*",
    "@norish/queue": "workspace:*",
    "@norish/shared": "workspace:*",
    "@norish/ui": "workspace:*",
    "@norish/web": "workspace:*"
  },
  "devDependencies": {
    "@heroui/react": "^2.8.9",
    "@tanstack/react-query": "^5.90.21",
    "@trpc/server": "^11.10.0",
    "@trpc/tanstack-react-query": "^11.10.0",
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@testcontainers/postgresql": "^11.12.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^5.1.4",
    "ai": "^6.0.95",
    "bullmq": "^5.69.3",
    "cross-env": "10.1.0",
    "drizzle-orm": "0.45.1",
    "drizzle-kit": "0.31.9",
    "eslint": "9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.3.0",
    "jszip": "3.10.1",
    "jsdom": "^28.1.0",
    "next": "16.1.6",
    "pg": "8.18.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "superjson": "^2.2.6",
    "tailwindcss": "^4.2.0",
    "testcontainers": "^11.12.0",
    "tsdown": "^0.20.0",
    "turbo": "^2.5.8",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.18",
    "zod": "4.3.6"
  },
  "pnpm": {
    "overrides": {
      "zod": "4.3.6",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "ioredis": "^5.9.3"
    }
  }
}
