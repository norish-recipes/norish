{
  "name": "@norish/api",
  "version": "0.26.0-beta",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./parser": "./src/parser/index.ts",
    "./recipes/enrichment-listener": "./src/recipes/enrichment-listener.ts",
    "./startup/upgrades": "./src/startup/upgrades/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "rm -rf dist && pnpm exec tsc -p tsconfig.json --noCheck",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "typecheck": "pnpm exec tsc --noEmit",
    "clean": "git clean -xdf .cache .turbo node_modules dist",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "dependencies": {
    "@norish/auth": "workspace:*",
    "@norish/config": "workspace:*",
    "@norish/db": "workspace:*",
    "@norish/i18n": "workspace:*",
    "@norish/queue": "workspace:*",
    "@norish/shared": "workspace:*",
    "@norish/shared-server": "workspace:*",
    "@norish/trpc": "workspace:*",
    "@trpc/server": "catalog:",
    "cheerio": "1.2.0",
    "drizzle-orm": "catalog:",
    "html-entities": "catalog:",
    "next": "catalog:",
    "playwright-core": "^1.64.0",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@norish/eslint-config": "workspace:*",
    "@norish/prettier-config": "workspace:*",
    "@norish/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "domhandler": "^5.0.3",
    "eslint": "catalog:",
    "ffmpeg-static": "^5.3.0",
    "heic-convert": "^2.1.0",
    "prettier": "catalog:",
    "sharp": "^0.35.5",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@norish/prettier-config"
}
