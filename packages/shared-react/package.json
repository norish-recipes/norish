{
  "name": "@norish/shared-react",
  "version": "0.27.0-beta",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./trpc": "./src/trpc/index.ts",
    "./platform": "./src/platform/index.ts",
    "./platform/testing": "./src/platform/testing.tsx",
    "./config": "./src/config/index.ts",
    "./calendar": "./src/calendar/index.ts",
    "./groceries": "./src/groceries/index.ts",
    "./reader": "./src/reader/index.ts",
    "./page-store": "./src/page-store/index.tsx",
    "./recipes": "./src/recipes/index.ts",
    "./realtime": "./src/realtime/index.ts",
    "./offline": "./src/offline/index.ts",
    "./offline/reachability": "./src/offline/reachability.ts",
    "./offline/react": "./src/offline/react/index.ts",
    "./offline/testing": "./src/offline/testing/index.ts"
  },
  "scripts": {
    "build": "rm -rf dist && pnpm exec tsc -p tsconfig.json --noCheck",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "typecheck": "pnpm exec tsc --noEmit",
    "clean": "git clean -xdf .cache .turbo node_modules dist",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "dependencies": {
    "@norish/config": "workspace:*",
    "@norish/i18n": "workspace:*",
    "@norish/shared": "workspace:*",
    "@norish/trpc": "workspace:*",
    "@tanstack/query-persist-client-core": "5.105.0",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "react": "catalog:",
    "superjson": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@norish/eslint-config": "workspace:*",
    "@norish/prettier-config": "workspace:*",
    "@norish/tsconfig": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@norish/prettier-config"
}
