{
  "name": "@norish/auth",
  "version": "0.26.0-beta",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth.ts",
    "./crypto": "./src/crypto.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "rm -rf dist && pnpm exec tsc -p tsconfig.json --noCheck",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "typecheck": "pnpm exec tsc --noEmit",
    "clean": "git clean -xdf .cache .turbo node_modules dist",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "catalog:",
    "@better-auth/core": "catalog:",
    "@better-auth/utils": "catalog:",
    "@norish/config": "workspace:*",
    "@norish/db": "workspace:*",
    "@norish/shared": "workspace:*",
    "@norish/shared-server": "workspace:*",
    "better-auth": "catalog:",
    "next": "catalog:"
  },
  "devDependencies": {
    "@norish/eslint-config": "workspace:*",
    "@norish/prettier-config": "workspace:*",
    "@norish/tsconfig": "workspace:*",
    "@testcontainers/valkey": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "ioredis": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@norish/prettier-config"
}
