{
  "name": "@norish/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/*": "./src/schema/*.ts",
    "./drizzle": "./src/drizzle.ts",
    "./zodSchemas": "./src/zodSchemas/index.ts",
    "./zodSchemas/*": "./src/zodSchemas/*.ts",
    "./repositories": "./src/repositories/index.ts",
    "./repositories/*": "./src/repositories/*.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "typecheck": "tsc --noEmit",
    "clean": "git clean -xdf .cache .turbo node_modules dist",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.1",
    "fuse.js": "^7.1.0",
    "pg": "8.18.0",
    "superjson": "^2.2.6",
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "@norish/api": "workspace:*",
    "@norish/auth": "workspace:*",
    "@norish/config": "workspace:*",
    "@norish/queue": "workspace:*",
    "@norish/shared": "workspace:*"
  },
  "devDependencies": {
    "@norish/eslint-config": "workspace:*",
    "@norish/prettier-config": "workspace:*",
    "@norish/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "@testcontainers/postgresql": "^11.12.0",
    "@types/pg": "8.16.0",
    "drizzle-kit": "0.31.9",
    "vitest": "^4.0.18"
  },
  "prettier": "@norish/prettier-config"
}
