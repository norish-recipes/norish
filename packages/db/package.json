{
  "name": "@norish/db",
  "version": "0.26.0-beta",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/*": "./src/schema/*.ts",
    "./drizzle": "./src/drizzle.ts",
    "./zodSchemas": "./src/zodSchemas/index.ts",
    "./zodSchemas/*": "./src/zodSchemas/*.ts",
    "./repositories": "./src/repositories/index.ts",
    "./repositories/*": "./src/repositories/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "rm -rf dist && pnpm exec tsc -p tsconfig.json --noCheck",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "typecheck": "pnpm exec tsc --noEmit",
    "test": "vitest run --config ./vitest.config.ts",
    "clean": "git clean -xdf .cache .turbo node_modules dist"
  },
  "dependencies": {
    "@norish/config": "workspace:*",
    "@norish/db-schema": "workspace:*",
    "@norish/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "fuse.js": "catalog:",
    "pg": "catalog:",
    "pino": "^10.4.0",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@norish/eslint-config": "workspace:*",
    "@norish/prettier-config": "workspace:*",
    "@norish/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@norish/prettier-config"
}
